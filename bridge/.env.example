# Generate a unique random secret (32+ characters); never commit the real value.
DIO_BRIDGE_TOKEN=replace-with-long-random-secret
DIO_BRIDGE_HOST=127.0.0.1
DIO_BRIDGE_PORT=8787

# Explicit opt-in for DEMO orders only. Defaults to false.
DIO_MT5_DEMO_EXECUTION_ENABLED=false

# Exact Vantage symbol name(s) shown in MT5 Market Watch.
DIO_MT5_ALLOWED_SYMBOLS=XAUUSD

# Hard server-side maximum in MT5 lots. Start conservatively on DEMO.
DIO_MT5_MAX_VOLUME=0.05
DIO_MT5_MAGIC=26051105
